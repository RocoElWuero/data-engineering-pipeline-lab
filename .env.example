# =========================
# MYSQL
# =========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=practica_data_engineering

# =========================
# SQL SERVER
# =========================
SQLSERVER_HOST=localhost\SQLEXPRESS
SQLSERVER_DATABASE=practica_sqlserver
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=your_password

# =========================
# KAFKA
# =========================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sales_clean_events

# =========================
# SPARK
# =========================
SPARK_MASTER=local[*]
OUTPUT_ROOT=your_output_root

# =========================
# PATHS
# =========================
DATA_LAKE_PATH=./data_lake